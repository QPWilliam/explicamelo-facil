generator client {
  provider      = "prisma-client-js"
  // native = tu Mac / servidor de build; rhel-openssl-3.0.x = funciones de Netlify (AWS Lambda).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Supabase: DATABASE_URL = pooler (puerto 6543, ?pgbouncer=true); DIRECT_URL = conexión directa (5432) para migraciones.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  slug     String    @id
  name     String
  articles Article[]
}

model Tag {
  name     String    @id
  articles Article[]
}

model Article {
  id            String   @id @default(uuid())
  slug          String   @unique
  title         String
  excerpt       String
  country       String
  cover         String
  coverAlt      String
  coverCredit   String   @default("")
  body          String
  author        String
  status        String   @default("draft")
  featured      Boolean  @default(false)
  publishedOnce Boolean  @default(false)
  publishedAt   DateTime
  updatedAt     DateTime @updatedAt
  categorySlug  String
  category      Category @relation(fields: [categorySlug], references: [slug])
  tags          Tag[]
  sources       Json
  checklist     Json

  @@index([status, publishedAt])
  @@index([categorySlug, status])
}
