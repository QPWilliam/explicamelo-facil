generator client {
  provider      = "prisma-client-js"
  // native = tu Mac / servidor de build; rhel-openssl-3.0.x = funciones de Netlify (AWS Lambda).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Supabase: DATABASE_URL = pooler (puerto 6543, ?pgbouncer=true); DIRECT_URL = conexión directa (5432) para migraciones.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Una sola tabla para todas las webs del proyecto.
// - "site" dice a qué web pertenece la guía (ver lib/sites.ts). NUNCA se consulta sin filtrar por él.
// - "locale" es el idioma de ESTA versión del texto. La versión en otro idioma es otra fila.
// - "translationKey" une las versiones de la misma guía en distintos idiomas (para las etiquetas hreflang).
// Las categorías y las etiquetas no tienen tabla propia: las categorías se definen en lib/sites.ts
// y las etiquetas son una lista de texto dentro de la propia guía.
model Article {
  id             String   @id @default(uuid())
  site           String
  locale         String
  slug           String
  translationKey String?
  title          String
  excerpt        String
  country        String
  city           String?
  cover          String
  coverAlt       String
  coverCredit    String   @default("")
  body           String
  author         String
  status         String   @default("draft")
  featured       Boolean  @default(false)
  publishedOnce  Boolean  @default(false)
  publishedAt    DateTime
  updatedAt      DateTime @updatedAt
  categorySlug   String
  tags           String[]
  sources        Json
  checklist      Json

  @@unique([site, locale, slug])
  @@index([site, locale, status, publishedAt])
  @@index([site, locale, categorySlug, status])
  @@index([site, translationKey])
}
