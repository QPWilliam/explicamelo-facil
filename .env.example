# ── Sitio ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Editor (/admin) ── npm run setup los genera en .env ────────────────
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ── Supabase: base de datos ─────────────────────────────────────────────
# Sin DATABASE_URL el sitio funciona con content/articles.json (solo lectura).
# Supabase > Connect > ORMs > Prisma:
DATABASE_URL=
DIRECT_URL=

# ── Supabase: imágenes (Storage) ────────────────────────────────────────
# Supabase > Project Settings > API Keys: clave "secret" (sb_secret_…) o la antigua service_role. Es SECRETA: nunca con prefijo NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=imagenes

# ── Google ──────────────────────────────────────────────────────────────
# Código de verificación de Search Console (método "etiqueta HTML"), opcional.
# Google Analytics 4: ID de medición (G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=
# Poner en true al solicitar AdSense (el script sirve para verificar el sitio). Anuncios visibles solo tras aprobación.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=
